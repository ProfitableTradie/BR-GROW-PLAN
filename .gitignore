# public/index.html and boardroom-growth-plan.html are BUILD OUTPUTS, but they
# are committed on purpose: Render's static-site build runs ./build.sh, and
# committing them means the app also works from a plain `git clone` with no
# build step at all.
.DS_Store
node_modules/
*.log

# Scratch landing area for flattened builds exported from Cowork, kept only
# long enough to split back into src/ and verify with `cmp`. Never a source
# of truth — src/ is.
src-incoming/
